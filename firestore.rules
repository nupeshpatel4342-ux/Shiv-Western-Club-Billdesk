rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
         (request.auth.token.email == "Nupeshpatel4342@gmail.com" && request.auth.token.email_verified == true));
    }

    function isStaff() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'billing_staff' || 
         isAdmin());
    }

    // Validate User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() < 128 &&
             data.email is string && data.email.size() < 256 &&
             data.role in ['admin', 'staff', 'owner', 'manager', 'billing_staff', 'customer'] &&
             data.createdAt is number &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 1024));
    }

    // Validate Bill
    function isValidBill(data) {
      return data.keys().hasAll(['id', 'total', 'paymentStatus', 'createdBy', 'timestamp']) &&
             data.id is string && data.id.size() < 128 &&
             data.total is number && data.total >= 0 &&
             data.paymentStatus in ['PAID', 'UNPAID'] &&
             data.createdBy is string && data.createdBy.size() < 128 &&
             data.timestamp is number &&
             (!('customer' in data) || (data.customer is string && data.customer.size() < 256)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() < 20)) &&
             (!('items' in data) || (data.items is list && data.items.size() < 100));
    }

    // Validate Settings
    function isValidSettings(data) {
      return (!('shopName' in data) || (data.shopName is string && data.shopName.size() < 256)) &&
             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() < 256)) &&
             (!('address' in data) || (data.address is string && data.address.size() < 1024)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 20)) &&
             (!('email' in data) || (data.email is string && data.email.size() < 256)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() < 10));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow registration of new user profiles (staff/customer)
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.role in ['staff', 'customer'] || isAdmin());
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    // Bills Collection
    match /bills/{billId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidBill(request.resource.data);
      allow update: if isAuthenticated() && isValidBill(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Settings Collection
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSettings(request.resource.data);
    }
    
    // Products Collection
    match /products/{prodId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isAdmin();
    }

    // Customers Ledger Collection
    match /customers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isStaff() || isAdmin();
    }

    // Orders Reservations Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || isAdmin();
    }

    // Inventory History Collection
    match /inventory_history/{logId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isAdmin();
    }

    // Test collection for connection check
    match /test/connection {
      allow read: if true;
    }
  }
}
