rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAuthenticated();
    }

    // Bills Collection
    match /bills/{billId} {
      allow read, write: if isAuthenticated();
    }

    // Settings Collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Categories Collection
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Banners Collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Products Collection
    match /products/{prodId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Customers Ledger Collection
    match /customers/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Orders Reservations Collection
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // Inventory History Collection
    match /inventory_history/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Test collection for connection check
    match /test/connection {
      allow read: if true;
    }
  }
}
